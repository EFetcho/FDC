# Copy to .env.local for local development. On Vercel, enter these in
# Project Settings → Environment Variables. Never commit real values.

# Public address of the dashboard. Must match the Google OAuth redirect.
APP_URL=https://dash.firstduecom.com

# From Google Cloud → Google Auth platform → Clients
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Who may sign in, comma-separated. This is also the default if the variable is omitted.
ALLOWED_EMAILS=fetcho@fdcav.com,fetcho@firstduecom.com

# Todoist → Settings → Integrations → Developer → Copy API token
TODOIST_API_TOKEN=

# Long random password, at least 32 characters. Changing it signs everyone out
# and requires the authenticator to be set up again.
SESSION_SECRET=

# Upstash Redis (Vercel integration). Either pair works.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Leave unset or false on the real site. true shows sample data and skips sign-in.
DEMO_MODE=false

# Optional. Defaults are the FDC Project Tracker.
# PROJECTS_SHEET_ID=1fHUpty80AJtD74MCewGC5yipWzvL3sWcYYgIELQmyOc
# PROJECTS_SHEET_TAB=Project Tracker
